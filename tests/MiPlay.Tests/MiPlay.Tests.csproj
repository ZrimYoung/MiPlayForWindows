    <Using Include="Xunit" />
    <Compile Include="../DLNACast.Tests/MiPlay*Tests.cs" Exclude="../DLNACast.Tests/MiPlayMediaPacingClockTests.cs" Link="Protocol/%(Filename)%(Extension)" />
